# Puertos locales. Cambiarlos si ya hay servicios usando los predeterminados.
FRONTEND_PORT=5173
BACKEND_PORT=8080
FLIGHTS_PORT=8081
POSTGRES_PORT=5432

# Base compartida por las APIs. El esquema world lo inicializa la API de vuelos.
POSTGRES_DB=tusviajes
POSTGRES_USER=admin
POSTGRES_PASSWORD=password

# Opcional. Configurar antes del primer arranque para inicializar la agencia de ejemplo.
TUSVIAJES_BOOTSTRAP_AGENCY_PASSWORD=

# Imagenes publicadas por los workflows de main.
BACKEND_IMAGE=rodribolanos/pdes-2026c2-backend:main
FLIGHTS_IMAGE=rodribolanos/pdes-2026c2-externalservice:main

# Perfil opcional de observabilidad: --profile observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Credenciales iniciales de Grafana para desarrollo local.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Activar junto con --profile observability para enviar las trazas a Tempo.
TRACING_EXPORT_ENABLED=false
# En el entorno local de Compose, 1.0 permite observar todas las solicitudes.
TRACING_SAMPLING_PROBABILITY=1.0
