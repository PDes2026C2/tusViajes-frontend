# Puertos locales. Cambiarlos si ya hay servicios usando los predeterminados.
FRONTEND_PORT=5173
BACKEND_PORT=8080
FLIGHTS_PORT=8081
POSTGRES_PORT=5432

# Base compartida por las APIs. El esquema world lo inicializa la API de vuelos.
POSTGRES_DB=tusviajes
POSTGRES_USER=admin
POSTGRES_PASSWORD=password

# Imagenes publicadas por los workflows de main.
BACKEND_IMAGE=rodribolanos/pdes-2026c2-backend:main
FLIGHTS_IMAGE=rodribolanos/pdes-2026c2-externalservice:main
